APP_NAME=GameSphere
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ─────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=gamesphere
DB_USERNAME=gamesphere
DB_PASSWORD=gamesphere_password
DB_ROOT_PASSWORD=rootpassword

# ─── Redis ────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PASSWORD=redis_password
REDIS_PORT=6379
REDIS_DB=0

# ─── Cache ────────────────────────────────────────────────────────────
CACHE_DRIVER=redis
CACHE_PREFIX=gamesphere_

# ─── Queue ────────────────────────────────────────────────────────────
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database

# ─── Sessions ─────────────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=10080
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false

# ─── Broadcasting (WebSockets via Reverb) ─────────────────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=gamesphere_app
REVERB_APP_KEY=gamesphere_key_change_in_production
REVERB_APP_SECRET=gamesphere_secret_change_in_production
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# ─── Object Storage (MinIO / S3-compatible) ───────────────────────────
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=gamesphere-media
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Private bucket (signed URLs)
AWS_PRIVATE_BUCKET=gamesphere-private

# MinIO ports (docker-compose)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# ─── Mail ─────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@gamesphere.gg
MAIL_FROM_NAME="${APP_NAME}"

# ─── Sanctum ──────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost,127.0.0.1

# ─── OAuth Providers ─────────────────────────────────────────────────
# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/api/v1/auth/oauth/google/callback

# Discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=${APP_URL}/api/v1/auth/oauth/discord/callback

# Twitch
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=${APP_URL}/api/v1/auth/oauth/twitch/callback

# Steam (OpenID, no OAuth secret needed)
STEAM_API_KEY=
STEAM_REDIRECT_URI=${APP_URL}/api/v1/auth/oauth/steam/callback

# Epic Games
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
EPIC_REDIRECT_URI=${APP_URL}/api/v1/auth/oauth/epic/callback

# Apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI=${APP_URL}/api/v1/auth/oauth/apple/callback

# ─── 2FA (Google Authenticator) ───────────────────────────────────────
GOOGLE2FA_ENABLED=true
GOOGLE2FA_ISSUER=GameSphere

# ─── Voice/Video Calling (Agora.io) ───────────────────────────────────
# Register at https://www.agora.io to get credentials
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Alternative: LiveKit
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# ─── AI Features (Optional) ───────────────────────────────────────────
# OpenAI for news summarization and recommendations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── News Sources ─────────────────────────────────────────────────────
# NewsAPI.org (optional, for additional gaming news sources)
NEWS_API_KEY=

# RAWG (game database API - optional enrichment)
RAWG_API_KEY=

# ─── Push Notifications ───────────────────────────────────────────────
# Firebase Cloud Messaging (FCM) for mobile push
FCM_SERVER_KEY=
FCM_SENDER_ID=

# ─── Nginx ────────────────────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ─── Next.js Frontend ─────────────────────────────────────────────────
NEXT_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080
NEXT_PUBLIC_REVERB_APP_KEY=gamesphere_key_change_in_production
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=ws
NEXT_PUBLIC_APP_NAME=GameSphere
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Horizon ──────────────────────────────────────────────────────────
HORIZON_BALANCE_STRATEGY=auto
HORIZON_MAX_PROCESSES=10
HORIZON_MIN_PROCESSES=1

# ─── Telescope (Dev) ──────────────────────────────────────────────────
TELESCOPE_ENABLED=true

# ─── Rate Limiting ────────────────────────────────────────────────────
RATE_LIMIT_AUTH=5
RATE_LIMIT_API=60
RATE_LIMIT_UPLOADS=10

# ─── Media Processing ─────────────────────────────────────────────────
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
MAX_VIDEO_SIZE_MB=500
MAX_IMAGE_SIZE_MB=10
MAX_AUDIO_SIZE_MB=50
THUMBNAIL_WIDTH=1280
THUMBNAIL_HEIGHT=720
